---
/**
 * CRT/глитч-эффект для Astro. Положите рядом crt-glitch.js
 * (src/components/crt-glitch/) и используйте:
 *
 *   ---
 *   import CrtGlitch from '../components/crt-glitch/CrtGlitch.astro';
 *   import hero from '../assets/hero.jpg';
 *   ---
 *   <CrtGlitch src={hero} alt="Обложка" preset={{ ca: 0.004, tear: 0.08 }} />
 *   <CrtGlitch video="/media/loop.mp4" poster="/media/loop.jpg" trigger="load" />
 */
import type { ImageMetadata } from 'astro';

interface Preset {
  jitter?: number; ca?: number; tear?: number; mask?: boolean; pixel?: number;
  duration?: number; fade?: boolean; trigger?: 'visible' | 'load' | 'hover' | 'none';
  idle?: number; fit?: 'cover' | 'contain';
}
interface Props extends Preset {
  src?: string | ImageMetadata;   // картинка: путь или импорт из src/assets
  video?: string;                 // или видео (mp4/webm, тот же домен)
  poster?: string;
  alt?: string;
  preset?: Preset;                // JSON из студии
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { src, video, poster, alt = '', preset = {}, class: className, loading = 'eager', ...rest } = Astro.props;
const params = JSON.stringify({ ...preset, ...rest });
const imgSrc = typeof src === 'object' ? src.src : src;
const w = typeof src === 'object' ? src.width : undefined;
const h = typeof src === 'object' ? src.height : undefined;
---
<crt-glitch preset={params} class:list={['crt', className]}>
  {video
    ? <video src={video} poster={poster} muted loop playsinline autoplay preload="auto" />
    : <img src={imgSrc} alt={alt} width={w} height={h} loading={loading} decoding="async" />}
</crt-glitch>

<script>
  import './crt-glitch.js'; // положите crt-glitch.js рядом с этим файлом
</script>

<style>
  .crt { display: block; position: relative; background: #000; }
  .crt :global(img), .crt :global(video) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
